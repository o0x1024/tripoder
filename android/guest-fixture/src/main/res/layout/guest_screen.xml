<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="24dp" android:paddingTop="64dp" android:background="#f5f8fc">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/guest_title" android:textSize="23sp" android:textColor="#17324d" />
    <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:padding="12dp" />
    <Button android:id="@+id/action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="客体按钮：调用 Java / Native" />
    <EditText android:id="@+id/input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="自动化输入目标" android:inputType="text" android:autofillHints="" />
    <LinearLayout android:id="@+id/graphics" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
</LinearLayout>
