<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="24dp" android:paddingTop="64dp" android:background="#f5f8fc">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/antidetect_title" android:textSize="23sp" android:textColor="#17324d" />
    <Button android:id="@+id/action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="重新运行检测" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="monospace" android:padding="12dp" />
    </ScrollView>
</LinearLayout>
