<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.tripoder.isolationprobe" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.MANAGE_VIRTUAL_MACHINE" />
    <uses-permission android:name="android.permission.USE_CUSTOM_VIRTUAL_MACHINE" />
    <queries><package android:name="dev.tripoder.hooklab" /></queries>
    <application android:label="Tripoder 隔离能力探针" android:allowBackup="false"
        android:debuggable="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
