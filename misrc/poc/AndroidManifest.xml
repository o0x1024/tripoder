<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.misrc.poc">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>

    <application android:label="misrcpoc" android:debuggable="true">
        <activity android:name=".Main" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service android:name=".Probe" android:exported="true">
            <intent-filter>
                <action android:name="com.misrc.poc.RUN"/>
            </intent-filter>
        </service>

        <service android:name=".Fake" android:exported="true">
            <intent-filter>
                <action android:name="com.misrc.poc.FAKE"/>
            </intent-filter>
        </service>

        <service android:name=".Json" android:exported="true">
            <intent-filter>
                <action android:name="com.misrc.poc.JSON"/>
            </intent-filter>
        </service>
    </application>
</manifest>
