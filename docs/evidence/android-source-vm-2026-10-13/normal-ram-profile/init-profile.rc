on early-init && property:ro.boot.nobootanim=1
    setprop debug.sf.nobootanimation 1

# Tripoder: software CPU timing is independent of RAM/window capabilities.
on early-init && property:ro.boot.low_perf=1
    setprop ro.hw_timeout_multiplier 50
    setprop ro.setupwizard.mode DISABLED
