{
  "kernelArgument": "androidboot.low_perf=1",
  "guestRc": "image-init.low_performance.rc",
  "hardwareTimeoutMultiplier": 50,
  "defaultMainWatchdogTimeoutSeconds": 3000,
  "watchdogStillEnabled": true,
  "lowRamMode": true,
  "setupWizard": "DISABLED",
  "selinuxChanged": false,
  "pacChanged": false,
  "adbAuthenticationChanged": false,
  "fullAndroidBootVerified": false,
  "sources": [
    "https://github.com/LineageOS/android_frameworks_base/blob/lineage-23.2/core/java/android/os/Build.java",
    "https://github.com/LineageOS/android_frameworks_base/blob/lineage-23.2/services/core/java/com/android/server/Watchdog.java"
  ]
}
