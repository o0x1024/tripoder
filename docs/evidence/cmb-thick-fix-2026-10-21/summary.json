  "fixes": [
    {
      "area": "Application owner",
      "cause": "Guest proxy exposes the real Application through getApplicationContext; the runtime retained the proxy for Activity ownership, so real lifecycle callbacks did not populate the Activity stack. Privacy dialog creation returned null and the launch framework rendered disconnected(null).",
      "change": "Resolve the guest-declared Application after onCreate; require attachment to the same logical LoadedApk and publish it consistently to component ownership and logical process view; reject host and unattached candidates."
    },
    {
      "area": "Manifest implicit broadcast",
      "cause": "Widget update broadcast hit MANIFEST_IMPLICIT_BROADCAST_NOT_IMPLEMENTED. A first implementation also read worker-only flat filters in authority and delivered zero receivers; that failed gate was corrected before final acceptance.",
      "change": "Share sealed declaration filter decoding; match manifest receivers and apply existing leases, permissions, exported/enabled checks and SDK background rules."
    },
    {
      "area": "Native media allocation",
      "cause": "Runtime denied the real DMA heap namespace; Codec2 could not find the system heap, selected ION, then dereferenced an uninitialized allocator at libcodec2_vndk.so+0x59038.",
      "change": "Read-only /dev/dma_heap directory and bounded first-level heap node access, including relative directory-fd opens; kernel/SELinux remain authoritative. /dev/ion and unrelated device nodes remain denied."
    }
  ],
